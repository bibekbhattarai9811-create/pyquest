// PyQuest database schema.
//
// Local dev uses SQLite (zero setup). To deploy, switch `provider` to
// "postgresql", point DATABASE_URL at a Postgres instance (e.g. Neon), and
// run `npx prisma migrate deploy`.

generator client {
  provider      = "prisma-client-js"
  // "native" for local machines; the rhel target is what Vercel's runtime needs.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (used by the app)
  directUrl = env("DIRECT_URL") // direct connection (used by migrations)
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         String        @default("USER") // "USER" | "ADMIN"
  status       String        @default("PENDING") // "PENDING" | "APPROVED" | "BLOCKED"
  createdAt    DateTime      @default(now())
  sessions     Session[]
  completions  Completion[]
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Completion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonKey   String // e.g. "python-basics/loops"
  completedAt DateTime @default(now())

  @@unique([userId, lessonKey])
  @@index([userId])
}

# Copy to .env  ->  cp .env.example .env
#
# PyQuest uses PostgreSQL. The easiest free option is Neon (https://neon.tech).
# From your Neon project's "Connection Details" panel:
#   - DATABASE_URL = the POOLED connection string (has "-pooler" in the host)
#   - DIRECT_URL   = the DIRECT connection string (no "-pooler")
# Both must include  ?sslmode=require

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional: comma-separated emails auto-promoted to ADMIN + APPROVED on signup.
# (The first account to sign up always becomes an admin regardless.)
ADMIN_EMAILS=""
